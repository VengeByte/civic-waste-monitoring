{
  "_comment": "Ordered VLM fallback registry. API keys are resolved from the named environment variables and must never be placed here. Groq is intentionally absent: as of 2026-10 its catalog contains no vision-capable model.",
  "providers": [
    {
      "name": "Google Gemini",
      "endpoint": "https://generativelanguage.googleapis.com/v1beta/openai/chat/completions",
      "api_key_env": "GEMINI_API_KEY",
      "timeout_seconds": 30,
      "max_retries": 1,
      "models": [
        { "id": "gemini-3.6-flash", "json_mode": true },
        { "id": "gemini-3.5-flash", "json_mode": true },
        { "id": "gemini-3.5-flash-lite", "json_mode": true }
      ]
    },
    {
      "name": "OpenRouter",
      "endpoint": "https://openrouter.ai/api/v1/chat/completions",
      "api_key_env": "OPENROUTER_API_KEY",
      "timeout_seconds": 25,
      "max_retries": 1,
      "extra_headers": {
        "HTTP-Referer": "https://civic-reporting.local",
        "X-Title": "Civic Garbage Reporting System"
      },
      "models": [
        { "id": "nvidia/nemotron-3.5-super-vl:free", "json_mode": true },
        { "id": "dots-studio/dots-3-note-preview:free", "json_mode": true }
      ]
    }
  ]
}
