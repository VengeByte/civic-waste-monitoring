# Copy to .env and fill in. Never commit .env.
GEMINI_API_KEY=
OPENROUTER_API_KEY=
# Optional, only if you later add a vision-capable Groq model:
# GROQ_API_KEY=

# Optional server-side email delivery
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=

# Optional public origin used inside evidence links behind a proxy
# PUBLIC_BASE_URL=

# VLM routing
# VLM_CONFIG_PATH=backend/vlm_providers.json
# VLM_TOTAL_TIMEOUT_SECONDS=30
# VLM_STARTUP_CHECK=0
# VLM_STRICT_STARTUP_CHECK=0
# EVIDENCE_TTL_SECONDS=86400
# EVIDENCE_MAX_ENTRIES=100
