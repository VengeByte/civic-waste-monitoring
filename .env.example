# Copy to .env and fill in. Never commit .env.
GEMINI_API_KEY=
OPENROUTER_API_KEY=
# Optional, only if you later add a vision-capable Groq model:
# GROQ_API_KEY=

# Gmail draft delivery (required for the Send via Gmail button)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/auth/google/callback

# Optional legacy server-side SMTP delivery
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=

# Optional public origin used inside evidence links behind a proxy
# PUBLIC_BASE_URL=

# Central municipal fallback when a pin is outside all covered corporation polygons
# CENTRAL_GRIEVANCE_EMAIL=grievance.central@chd.nic.in

# VLM routing
# VLM_CONFIG_PATH=backend/vlm_providers.json
# VLM_TOTAL_TIMEOUT_SECONDS=30
# VLM_STARTUP_CHECK=0
# VLM_STRICT_STARTUP_CHECK=0
# EVIDENCE_TTL_SECONDS=86400
# EVIDENCE_MAX_ENTRIES=100
